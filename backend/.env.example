APP_ENV=development
LOG_LEVEL=INFO
# Relative paths are resolved against the backend/ directory.
WORKBOOK_PATH=../data/AI_Engineer_Leave_Management_Dataset.xlsx
WORKBOOK_AUTO_REFRESH=true
# Uploaded datasets are stored under this directory (server-generated names).
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_MB=10
MAX_UPLOAD_ROWS=20000
MAX_UPLOAD_COLUMNS=100
MAX_RETRIEVED_CHUNKS=5
# Extra lexical score floor (usually 0; match-count filtering handles weak hits).
MIN_RELEVANCE_SCORE=0.0
GROQ_API_KEY=
# Circuit breaker: consecutive transient failures before failing fast,
# and how long to wait before allowing a recovery probe.
GROQ_CIRCUIT_FAILURE_THRESHOLD=3
GROQ_CIRCUIT_COOLDOWN_SECONDS=30
FRONTEND_ORIGIN=http://localhost:5173
